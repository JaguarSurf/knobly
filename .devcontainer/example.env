# Local environment for the devcontainer. Copied to /workspace/.env (git-ignored) on first start.
# Never commit real values.

# ==== Android release signing (optional) ==== #
# Alternatively, use a keystore.properties file at the repository root (also git-ignored).
# KNOBLY_KEYSTORE_FILE=/workspace/.local/knobly-release.jks
# KNOBLY_KEYSTORE_PASSWORD=
# KNOBLY_KEY_ALIAS=knobly
# KNOBLY_KEY_PASSWORD=
